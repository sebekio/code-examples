{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug cell.cpp (g++)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_cpp/cell",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build_cpp",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cpp",
            "sourceFileMap": {
                "/workspaces/sys-lab-1": "${workspaceFolder}"
            }
        }
    ]
}
